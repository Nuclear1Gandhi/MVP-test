# * Copy to .env.local. Keys: Project Settings → API (API Keys tab, or Connect dialog).
# * @see https://supabase.com/docs/guides/api/api-keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# * Recommended (hosted platform): publishable key sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# * Legacy fallback during transition (JWT anon key) — omit if using publishable only.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# * Recommended for /admin: secret key sb_secret_... (server-only; bypasses RLS).
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# * Legacy fallback — omit if using SUPABASE_SECRET_KEY only.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# * Comma-separated emails allowed to open /admin (case-insensitive).
ADMIN_EMAILS=you@example.com
